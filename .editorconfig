# https://editorconfig.org

root = true

[*]
indent_style = tab
indent_size = 4
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true


[*.R]
indent_size = 2


[*.{yml,yaml,cff}]
indent_style = space
indent_size = 2


[renv.lock]
indent_style = space
indent_size = 2
